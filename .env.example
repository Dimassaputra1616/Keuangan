# Salin file ini menjadi `.env` lalu sesuaikan bila perlu:
#   cp .env.example .env
#
# File `.env` asli tidak pernah ikut ter-commit ke git.

# Prisma: path-nya relatif terhadap lokasi `prisma/schema.prisma`, bukan root
# proyek. Jadi `file:./dev.db` berarti file-nya ada di `prisma/dev.db`.
DATABASE_URL="file:./dev.db"
