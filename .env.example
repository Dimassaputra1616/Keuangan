# Salin file ini menjadi `.env` lalu sesuaikan bila perlu:
#   cp .env.example .env
#
# File `.env` asli tidak pernah ikut ter-commit ke git.

# Prisma: URL koneksi Postgres (Supabase). Untuk Vercel/produksi, pakai
# connection pooler (port 6543) dengan `?pgbouncer=true`.
# Contoh: postgresql://postgres:[password]@db.xxx.supabase.co:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://user:password@localhost:5432/keuangan"

# Gembok HTTP Basic Auth. Di deployment publik keduanya WAJIB diset —
# semua route menolak akses tanpa login yang benar.
# Kosongkan hanya untuk mode lokal tanpa password.
# BASIC_AUTH_USER=bangdim
# BASIC_AUTH_PASS=ganti-dengan-password-kuat
